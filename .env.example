# ChronoClass Environment Variables
# Copy this file to .env and replace with your actual configuration

# Database Configuration
# For Docker Postgres use: jdbc:postgresql://localhost:5433/chronoclass
# For H2 (Default) use: jdbc:h2:mem:chronoclass;DB_CLOSE_DELAY=-1;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE
DB_URL=jdbc:postgresql://localhost:5433/chronoclass

# Database Username
DB_USER=chronoclass

# Database Password
DB_PASSWORD=chronoclass123

# Server Port
SERVER_PORT=8080
